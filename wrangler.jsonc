/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voidmech",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	// Production is served on <worker>.<subdomain>.workers.dev.
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "voidmech-site",
			"database_id": "6a49035d-e3cd-4ec9-ab02-a9b18bfdbe46",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Hero video clips, served same-origin by GET /media/:file (src/lib/endpoints/media.ts).
	 * They live in R2, not static assets, because static assets ignore Range
	 * requests and Safari/iOS will not play video without 206 responses.
	 * Upload steps: content/marketing-assets/web/README.md.
	 */
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "voidmech"
		}
	],
	/**
	 * Per-IP rate limits for the public API (see src/lib/api/guards.ts).
	 * Counters are per Cloudflare location and best effort, not exact.
	 * namespace_id is any account-unique integer string.
	 */
	"ratelimits": [
		{
			"name": "FORM_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "GAME_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		// One shared counter for ALL crash reports (not per IP): caps total D1 writes
		// at ~28.8k/day, well inside D1's free 100k/day. See guards.ts globalRateLimit.
		{
			"name": "CRASH_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 20, "period": 60 }
		},
		// Per-IP cap on public read endpoints (poll state), protecting D1's free read quota.
		{
			"name": "READ_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	/**
	 * Worker Previews (`wrangler preview`, one per branch at
	 * <branch>-<worker>.<subdomain>.workers.dev). Previews inherit nothing from
	 * production, so everything the Worker needs is repeated here, pointed at a
	 * staging database and separate rate-limit counters. Preview secrets are set
	 * with `wrangler preview base-config secret put <NAME>`.
	 * https://developers.cloudflare.com/workers/previews/configuration/
	 */
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "voidmech-site-preview",
				"database_id": "ef237b47-1d98-4ec6-a4a2-445205d9183e"
			}
		],
		// Read-only public media: previews share the production bucket.
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "voidmech"
			}
		],
		"ratelimits": [
			{
				"name": "FORM_LIMITER",
				"namespace_id": "2001",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "GAME_LIMITER",
				"namespace_id": "2002",
				"simple": { "limit": 10, "period": 60 }
			},
			{
				"name": "CRASH_LIMITER",
				"namespace_id": "2003",
				"simple": { "limit": 20, "period": 60 }
			},
			{
				"name": "READ_LIMITER",
				"namespace_id": "2004",
				"simple": { "limit": 30, "period": 60 }
			}
		],
		"observability": {
			"enabled": true
		}
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}