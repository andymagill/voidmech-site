/**
 * Used only to apply D1 migrations to the preview (staging) database:
 *
 *   wrangler d1 migrations apply voidmech-site-preview --remote --config wrangler.preview-migrations.jsonc
 *
 * The main wrangler.jsonc lists the production database at the top level and
 * the staging database only inside `previews`, and `migrations apply` reads the
 * top-level list. Keep the id in sync with `previews.d1_databases` there.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voidmech",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "voidmech-site-preview",
			"database_id": "ef237b47-1d98-4ec6-a4a2-445205d9183e",
			"migrations_dir": "migrations"
		}
	]
}
